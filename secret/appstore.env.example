# App Store Connect API key (for tool/upload_release.sh's automated xcrun altool upload).
# Copy this file to secret/appstore.env and fill in real values; secret/ is git-ignored (/secret/*).
# Generate the key at https://appstoreconnect.apple.com/access/integrations/api (App Manager role
# or higher) and place the downloaded AuthKey_<ASC_KEY_ID>.p8 file in this same secret/ directory.
ASC_KEY_ID=
ASC_ISSUER_ID=
