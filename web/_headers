# Cloudflare Workers static-assets headers (copied into build/web).
# Bootstrap/entry files must revalidate so a deploy is picked up on the next
# load; everything else (canvaskit, fonts, assets) is safe to cache longer.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=86400
/canvaskit/*
  Cache-Control: public, max-age=604800, immutable
