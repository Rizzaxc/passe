---
interface Props {
  compact?: boolean;
  inverse?: boolean;
}

const { compact = false, inverse = false } = Astro.props;
---

<a class:list={['brand', { compact, inverse }]} href="/" aria-label="Passe — trang chủ">
  <img src="/brand/passe-mark.svg" alt="" width="42" height="42" />
  <span>Passe</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 850;
    letter-spacing: -0.05em;
    text-decoration: none;
  }

  .brand img {
    width: 2.3rem;
    height: 2.3rem;
  }

  .brand.compact {
    font-size: 1.2rem;
  }

  .brand.compact img {
    width: 1.9rem;
    height: 1.9rem;
  }

  .brand.inverse {
    color: white;
  }
</style>
