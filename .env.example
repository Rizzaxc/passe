ENV=

SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_DB_PASSWORD=

SENTRY_DSN=

# Native Google sign-in OAuth client ids (Google Cloud Console > Credentials).
# GOOGLE_IOS_CLIENT_ID  -> the "iOS" OAuth client id (drives Info.plist URL scheme)
# GOOGLE_WEB_CLIENT_ID  -> the "Web" OAuth client id (passed as serverClientId;
#                          must also be set as the Google provider client id in
#                          the Supabase dashboard so token audiences match)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Google AdMob ad UNIT ids (per platform). Leave blank to use Google's test
# units. The AdMob APP id is NOT here — it lives in the native manifests
# (AndroidManifest.xml meta-data + Info.plist GADApplicationIdentifier).
ADMOB_BANNER_UNIT_ANDROID=
ADMOB_BANNER_UNIT_IOS=
ADMOB_INTERSTITIAL_UNIT_ANDROID=
ADMOB_INTERSTITIAL_UNIT_IOS=
